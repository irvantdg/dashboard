{
  "project_name": "Member & Transaction Intelligence (Intelijen Anggota & Transaksi)",
  "app_type": "dashboard",
  "archetype": "SWISS & HIGH-CONTRAST / PERFORMANCE PRO (Banking & Infrastructure)",
  "language": "Indonesian (Bahasa Indonesia)",
  "theme": "Light mode default with high contrast, crisp structural borders, and dark navy header/sidebar anchors",
  "typography": {
    "heading_font": "Plus Jakarta Sans, sans-serif",
    "body_font": "IBM Plex Sans, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "weights": {
      "light": "300",
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "hierarchy": {
      "page_title": "text-2xl sm:text-3xl font-bold tracking-tight text-slate-900",
      "section_title": "text-lg sm:text-xl font-semibold tracking-tight text-slate-900",
      "card_title": "text-sm font-semibold uppercase tracking-wider text-slate-600",
      "table_header": "text-xs font-semibold uppercase tracking-wider text-slate-500",
      "metric_value": "text-2xl lg:text-3xl font-bold tracking-tight text-slate-900 font-mono",
      "body": "text-sm font-normal text-slate-700 leading-relaxed",
      "caption": "text-xs font-normal text-slate-500"
    },
    "number_formatting": {
      "locale": "id-ID",
      "currency_symbol": "Rp",
      "examples": [
        "Rp1,2 Miliar",
        "Rp450 Juta",
        "Rp15,8 Triliun",
        "Rp125.400.000",
        "1,45 Juta Tx"
      ],
      "compact_rules": "Use Miliar (M), Triliun (T), Juta (Jt) for high density metric cards and table columns."
    }
  },
  "colors": {
    "palette": {
      "nav_primary": "#0F172A",
      "nav_secondary": "#1E293B",
      "accent_blue": "#0284C7",
      "accent_teal": "#0D9488",
      "bg_app": "#F8FAFC",
      "bg_card": "#FFFFFF",
      "border_default": "#E2E8F0",
      "border_strong": "#CBD5E1",
      "text_primary": "#0F172A",
      "text_secondary": "#475569",
      "text_muted": "#64748B"
    },
    "status_badges": {
      "Live": {
        "label": "Live",
        "bg": "bg-emerald-50",
        "text": "text-emerald-700",
        "border": "border-emerald-200",
        "dot": "bg-emerald-500"
      },
      "UAT": {
        "label": "UAT",
        "bg": "bg-amber-50",
        "text": "text-amber-700",
        "border": "border-amber-200",
        "dot": "bg-amber-500"
      },
      "Development": {
        "label": "Development",
        "bg": "bg-sky-50",
        "text": "text-sky-700",
        "border": "border-sky-200",
        "dot": "bg-sky-500"
      },
      "Preparation": {
        "label": "Preparation",
