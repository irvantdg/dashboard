  "layout_and_navigation": {
    "structure": "Fixed dark navy topbar or collapsible sidebar with persistent search, quick date period selector, user role badge, and notifications.",
    "container_padding": "px-4 py-6 sm:px-6 lg:px-8 max-w-[1600px] mx-auto",
    "grid_gap": "gap-4 sm:gap-6",
    "cards": "bg-white border border-slate-200 rounded-lg shadow-sm hover:shadow transition-shadow p-5"
  },
  "pages_architecture": [
    {
      "page_id": "overview",
      "title_id": "Ringkasan Eksekutif (Overview)",
      "components": [
        "Executive KPI Cards (Volume, Nominal, Revenue/Fee, Live Matrix Coverage %)",
        "Period Comparison Badges (MoM / YoY / YTD)",
        "Monthly Trend Line/Bar Chart (Recharts)",
        "Status Distribution Donut Chart",
        "Top 5 Member Banks & Top 5 Products Bar Chart"
      ]
    },
    {
      "page_id": "matriks_mitra",
      "title_id": "Matriks Mitra (Member x Product Matrix)",
      "components": [
        "Sticky-header and sticky-first-column Matrix Grid (24 Banks x 14 Products)",
        "Implementation Status Badges with quick-filter toggles",
        "Search & Multi-select Filter Bar with active count chips",
        "Cell detail click popover / sheet preview"
      ]
    },
    {
      "page_id": "rekap_transaksi",
      "title_id": "Rekap Transaksi (Transaction Analytics)",
      "components": [
        "Volume & Nominal Aggregated Performance Charts",
        "Issuer vs Acquirer Net Position Table & Chart",
        "Granular Product & Channel Filter Bar",
        "Data Export (CSV / Excel)"
      ]
    },
    {
      "page_id": "detail_member",
      "title_id": "Detail Member (Member Deep-Dive)",
      "components": [
        "Member Bank Profile & Contact Metadata",
        "Product Adoption Timeline",
        "Volume & Revenue Contribution Breakdown",
        "Transaction Health & SLA Status Indicators"
      ]
    },
    {
      "page_id": "management_insights",
      "title_id": "Management Insights (Analisis Lanjutan)",
      "components": [
        "Rule-based Insight Cards with Severity Badges (Critical / Warning / Positive / Info)",
        "Waterfall Chart (Revenue/Volume Drivers)",
        "Growth-vs-Contribution Quadrant Scatter Chart",
        "Member x Product Transaction Heatmap",
        "Period Filter Controls (MoM / YoY / YTD / QoQ / Custom / Rolling 12M)"
      ]
    },
    {
      "page_id": "data_management",
      "title_id": "Manajemen Data (CSV/Excel Import Wizard)",
      "components": [
        "7-Step Staging Import Wizard: 1. Select File -> 2. Preview -> 3. Map Columns -> 4. Validate -> 5. Error Resolution -> 6. Confirm -> 7. Result Summary",
        "Import History & Staging Audit Table"
      ]
    },
    {
      "page_id": "user_management",
      "title_id": "Manajemen Pengguna (User & RBAC)",
      "components": [
        "User List Table with Role Badges (Admin, Business Analyst, Management)",
        "Role Permissions Matrix Modal / Sheet"
      ]
    },
    {
      "page_id": "metric_definitions",
      "title_id": "Definisi Metrik & Konfigurasi Batas",
      "components": [
        "Metric Glossary Table with Formula Tooltips",
        "Saved Views Configuration",
        "Threshold Config Page for Anomaly Alerts"
      ]
    },
    {
      "page_id": "audit_log",
      "title_id": "Log Audit Sistem",
      "components": [
        "Audit Trail Table with Timestamp, User, Action, Entity, and IP Address",
        "Filterable Event Log"
      ]
    }
  ],
  "accessibility_and_testing": {
    "test_id_convention": "All interactive elements (buttons, inputs, select menus, filter chips, table rows, tab triggers, modal toggles) MUST include data-testid in kebab-case format.",
    "sample_test_ids": [
      "data-testid=\"nav-link-overview\"",
      "data-testid=\"nav-link-matriks-mitra\"",
      "data-testid=\"nav-link-rekap-transaksi\"",
      "data-testid=\"nav-link-management-insights\"",
      "data-testid=\"kpi-card-total-volume\"",
      "data-testid=\"kpi-card-total-nominal\"",
      "data-testid=\"matrix-filter-bank-search\"",
      "data-testid=\"matrix-filter-status-select\"",
      "data-testid=\"matrix-cell-bank-01-product-qris\"",
      "data-testid=\"import-wizard-step-1-file-input\"",
      "data-testid=\"import-wizard-submit-button\"",
      "data-testid=\"period-comparison-dropdown\"",
      "data-testid=\"insight-card-critical-1\""
    ]
  },
  "instructions_to_main_agent": [
    "Use standard Javascript React (.js / .jsx) components matching existing project structure.",
    "Strictly follow Indonesian banking number formats: Rp1,2 Miliar, Rp450 Juta, Rp15,8 Triliun.",
    "Never use fully transparent background on overlays, headers, dropdown menus, or tooltips.",
    "Use Recharts or Shadcn chart wrappers for responsive, accessible data visualization.",
    "Ensure the 24 fictional member banks ('Bank Alias 01' through 'Bank Alias 24') and 14 products are fully represented across matrix and charts with realistic mock data.",
    "Add data-testid to every interactive component for automated test assertions."
  ]
}